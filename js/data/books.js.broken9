export const LEVEL_META = {
  A1: { label: '入门', tone: 'a1' },
  A2: { label: '基础', tone: 'a2' },
  B1: { label: '进阶', tone: 'b1' },
  B2: { label: '高阶', tone: 'b2' },
  C1: { label: '精通', tone: 'c1' },
  C2: { label: '母语级', tone: 'c2' },
};

export function bookById(id) { return WORD_BOOKS.find(b => b.id === id); }
export function totalBookWords() { return WORD_BOOKS.reduce((n, b) => n + b.words.length, 0); }
